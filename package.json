{
  "name": "bcps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual --pass-with-no-tests",
    "typecheck": "tsc -b --noEmit",
    "check": "tsc -b && biome ci . && node scripts/check-layers.ts && node scripts/check-content.ts && node scripts/check-state-version.ts && node scripts/check-banned.ts",
    "budgets": "node scripts/check-budgets.ts",
    "brand:icons": "node scripts/render-icons.mjs",
    "ci": "bash scripts/ci-local.sh all",
    "ci:static": "bash scripts/ci-local.sh static",
    "ci:unit": "bash scripts/ci-local.sh unit",
    "ci:build": "bash scripts/ci-local.sh build",
    "ci:e2e": "bash scripts/ci-local.sh e2e",
    "ci:visual": "bash scripts/ci-local.sh visual"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
